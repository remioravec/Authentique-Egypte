dist/
node_modules/
.DS_Store

# Les maquettes ont une seule source : /maquettes.
# outils/construire.sh les recopie ici au moment du build.
plugin/ae-refonte-review/maquettes/*.html
docs/contenus.json
docs/extraits.json

outils/__pycache__/
audit-*.json
plugin/*.zip

# La sauvegarde est versionnée compressée, pas en clair.
sauvegarde/avant-mise-en-ligne/*/

# Paquet de transport des commits non poussés : il contient l'historique
# du dépôt, il n'a donc rien à faire dedans. Régénéré à la demande par
#   git bundle create refonte-commits-en-attente.bundle \
#       origin/<branche>..HEAD --branches=<branche>
refonte-commits-en-attente.bundle
